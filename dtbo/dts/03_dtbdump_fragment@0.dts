				pinctrl-5 = <0x00>;
			};
		};

		fragment@120 {

			__overlay__ {

				sx937x@2c {
					pinctrl-0 = <0x00>;
					pinctrl-1 = <0x00>;
					cap_vdd-supply = <0x00>;
				};
			};
		};
	};
};
